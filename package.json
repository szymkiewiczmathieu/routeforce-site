{
  "scripts": {
    "build:css": "tailwindcss -i tailwind.input.css -o assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o assets/css/tailwind.min.css --watch",
    "build:public": "python3 scripts/build_public.py",
    "verify:public": "python3 scripts/verify_public.py",
    "test:redirects": "node --test tests/dist-worker.test.mjs",
    "test:data-checker": "node --test tests/data-readiness-checker.test.mjs",
    "deploy:production": "python3 scripts/build_public.py && python3 scripts/verify_public.py && npx wrangler@4.112.0 deploy"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/forms": "^0.5.11",
    "googleapis": "^171.4.0",
    "playwright": "^1.59.1",
    "puppeteer-core": "^24.40.0",
    "tailwindcss": "^4.2.2"
  }
}
